# Python and tooling
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.claude/

# Data: raw and processed, per-subject QC jsons and plots (see README, Datasets)
datasets/

# Run logs
logs/
*.log

# Large binary formats (never tracked anywhere)
*.fif
*.npy
*.pkl
*.eeg
*.set
*.fdt
*.mat

# Multiverse: COMET state (universe scripts, combined pkl) and per-branch ICA caches.
# Tracked: results/multiverse/<dataset>/outputs/ (per-subject table, zoom cache).
results/multiverse/*/comet/
results/multiverse/*/branches/
# Earlier 40 Hz treadmill run, kept read-only; summarised in results/supplementary/.
results/multiverse/stepup_40hz_archive/

# Local diagnostics (scripts/diag) and their outputs
scripts/diag/
results/pipeline/*/qc/*_band_diagnostics.txt
results/pipeline/*/qc/*_gedai_gate_check.txt
results/pipeline/*/qc/*_baseline_120s_check.txt
